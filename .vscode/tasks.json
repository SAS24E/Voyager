{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "${workspaceFolder}/Player/Player.cpp",
                "${workspaceFolder}/Inventory/Inventory.cpp",
                "${workspaceFolder}/Utility/Utility.cpp",
                "${workspaceFolder}/GameEngine/GameEngine.cpp",
                "${workspaceFolder}/Room/Room.cpp",
                "${workspaceFolder}/Enemy/Enemy.cpp",
                "${workspaceFolder}/main.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}